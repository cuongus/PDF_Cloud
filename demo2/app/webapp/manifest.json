{
  "_version": "1.59.0",
  "sap.app": {
    "id": "zdemopnkfdp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_demo_ads_pnk_o4/srvd/sap/zui_demo_ads_pnk_o4/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zdemo_pnk_fdp-display": {
          "semanticObject": "zdemo_pnk_fdp",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zdemopnkfdp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ListReportTarget",
          "target": "ListReportTarget"
        },
        {
          "pattern": "GoodsReceipt({key}):?query:",
          "name": "ObjectPageTarget",
          "target": "ObjectPageTarget"
        }
      ],
      "targets": {
        "ListReportTarget": {
          "type": "Component",
          "id": "ListReportTarget",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/GoodsReceipt",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "GoodsReceipt": {
                  "detail": {
                    "route": "ObjectPageTarget"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectionMode": "Multi",
                    "enableExport": true,
                    "condensedTableLayout": true,
                    "rowCountMode": "Auto"
                  },
                  "actions": {
                    "printPreview": {
                      "press": "zdemopnkfdp.ext.PrintPreview.onPrintPreview",
                      "text": "{i18n>printPreview}",
                      "requiresSelection": true,
                      "enabled": true
                    },
                    "designFiles": {
                      "press": "zdemopnkfdp.ext.PrintPreview.onDesignFiles",
                      "text": "{i18n>designFiles}",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
        "ObjectPageTarget": {
          "type": "Component",
          "id": "ObjectPageTarget",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/GoodsReceipt",
              "content": {
                "header": {
                  "actions": {
                    "printPreview": {
                      "press": "zdemopnkfdp.ext.PrintPreview.onPrintPreview",
                      "text": "{i18n>printPreview}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}